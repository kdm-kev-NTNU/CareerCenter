# =============================================================================
# CareerCenter – mal for miljøvariabler
# Kopier til lokal fil:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LOKAL UTVIKLING
# -----------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://careercenter:careercenter@localhost:5432/careercenter?schema=public
# Påkrevd i .env (min. 32 tegn). Generer egen – ikke commit .env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3000
UPLOAD_DIR=./uploads
AUTH_DISABLED=false

# Tom = Vite proxyer /api til API (anbefalt lokalt)
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:3000

# Kun for tester uten database:
# CAREERCENTER_REPOSITORY=memory

# -----------------------------------------------------------------------------
# RAILWAY (produksjon)
# Legg inn under Variables i Railway-dashboardet (Service → Variables).
# -----------------------------------------------------------------------------
# NODE_ENV=production
#
# Koble Postgres-plugin til app-tjenesten; Railway setter da DATABASE_URL for deg.
# Eller lim inn connection string fra Postgres → Connect.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public
#
# Påkrevd: minst 32 tegn. Generer f.eks. med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=<sett-i-railway-dashboard>
#
# Railway setter ofte PORT automatisk; behold 3000 hvis du ikke bruker ${PORT}.
# PORT=3000
#
# Persistente filopplastinger (anbefalt: Railway Volume mountet på /app/uploads)
# UPLOAD_DIR=/app/uploads
#
# AUTH_DISABLED=false
#
# Samme origin i prod (API serverer også frontend) – la stå tom:
# VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# docker:dev  → http://localhost:5173 (web), http://localhost:3000 (api)
# docker:prod → http://localhost:3000 (alt i én container)
