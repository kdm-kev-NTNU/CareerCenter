# =============================================================================
# CareerCenter – mal for miljøvariabler
# Kopier til lokal fil:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LOKAL UTVIKLING
# -----------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://careercenter:careercenter@localhost:5432/careercenter?schema=public
# Påkrevd i .env (min. 32 tegn). Generer egen – ikke commit .env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3000
UPLOAD_DIR=./uploads
AUTH_DISABLED=false

# Valgfritt – Interview Mecca / AI (tom = AI-funksjoner deaktivert)
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_VOICE_MODEL=gpt-live-1
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Tom = Vite proxyer /api til API (anbefalt lokalt)
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:3000

# Kun for tester uten database:
# CAREERCENTER_REPOSITORY=memory

# -----------------------------------------------------------------------------
# RAILWAY (produksjon – to tjenester)
# Backend-tjeneste: DATABASE_URL, JWT_SECRET, PORT, UPLOAD_DIR, NODE_ENV=production
# Frontend-tjeneste: API_UPSTREAM=${{careercenter.RAILWAY_PRIVATE_DOMAIN}}:3000
# Koble Postgres-plugin til backend-tjenesten.
# Legg custom domain på frontend-tjenesten (nginx proxyer /api til backend).
# -----------------------------------------------------------------------------
# NODE_ENV=production
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public
# JWT_SECRET=<sett-i-railway-dashboard>
# PORT=3000
# UPLOAD_DIR=/app/uploads
# AUTH_DISABLED=false
#
# Frontend (Railway Variables):
# API_UPSTREAM=${{careercenter.RAILWAY_PRIVATE_DOMAIN}}:3000
#
# Tom VITE_API_BASE_URL i prod – nginx serverer SPA og proxyer /api (samme origin).

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# docker:dev  → http://localhost:5174 (frontend), http://localhost:3000 (backend)
# docker:prod → http://127.0.0.1:8080 (frontend/nginx → backend; bruk 127.0.0.1 på Windows hvis localhost feiler)
