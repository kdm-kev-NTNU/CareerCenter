{
  "name": "@careercenter/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:prod": "prisma migrate deploy && node dist/prisma/seed.js && node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@careercenter/shared": "file:../../packages/shared",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
