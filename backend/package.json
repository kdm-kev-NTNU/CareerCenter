{
  "name": "@careercenter/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:prod": "prisma migrate deploy && node dist/backend/prisma/seed.js && node dist/backend/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@careercenter/shared": "file:../packages/shared",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.1",
    "fflate": "^0.8.2",
    "mammoth": "^1.9.0",
    "nanoid": "^5.0.9",
    "unpdf": "^0.12.1",
    "openai": "^7.33.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
