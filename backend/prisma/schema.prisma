generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String              @unique
  pinHash            String
  failedAttempts     Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  courses            CoursePlan[]
  selfStudyCourses   SelfStudyCourse[]
  educationBooks     EducationBook[]
  learningPlatforms  LearningPlatform[]
  aiResources        AiResource[]
  bachelorKnowledge           BachelorKnowledge[]
  bachelorFolders             BachelorFolder[]
  bachelorFiles               BachelorFile[]
  competitions                CompetitionEntry[]
  internshipStatuses          InternshipStatusOption[]
  internshipLocations         InternshipLocationOption[]
  internshipRequirementTypes  InternshipRequirementType[]
  internships                 Internship[]
  graduateProgramStatuses          GraduateProgramStatusOption[]
  graduateProgramLocations         GraduateProgramLocationOption[]
  graduateProgramRequirementTypes  GraduateProgramRequirementType[]
  graduatePrograms                   GraduateProgram[]
  thesisCompanies                    ThesisCompany[]
  interviewKnowledgeDocs             InterviewKnowledgeDoc[]
  interviewCaseEntries               InterviewCaseEntry[]
  interviewBankQuestions             InterviewBankQuestion[]
  interviewPrepPlans                 InterviewPrepPlan[]
  interviewSimulatorSettings         InterviewSimulatorSettings[]
  interviewSessions                  InterviewSession[]
  interviewAbilityTestAttempts       InterviewAbilityTestAttempt[]
  interviewVideoSettings             InterviewVideoSettings?
  interviewVideoRuns                 InterviewVideoRun[]
  interviewImportJobs                InterviewImportJob[]
  candidateBackground                CandidateBackground?
}

model CoursePlan {
  id         String   @id @default(cuid())
  userId     String
  semester   Int
  courseCode String
  title      String
  credits    Float
  status     String
  notes      String   @default("")
  trackTags  String[]
  sortOrder  Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerTrackSetting {
  id           String @id
  defaultLabel String
  label        String
  sortOrder    Int    @default(0)
}

model InternshipStatusOption {
  id          String       @id @default(cuid())
  userId      String
  label       String
  kind        String       @default("stage")
  sortOrder   Int          @default(0)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  internships Internship[]
}

model InternshipLocationOption {
  id        String @id @default(cuid())
  userId    String
  label     String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InternshipRequirementType {
  id           String                    @id @default(cuid())
  userId       String
  label        String
  description  String                    @default("")
  sortOrder    Int                       @default(0)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements InternshipRequirementItem[]
}

model Internship {
  id             String                    @id @default(cuid())
  userId         String
  companyName    String
  title          String
  description    String                    @default("")
  applicationUrl String                    @default("")
  notes          String                    @default("")
  deadline       DateTime?
  statusId       String
  stageIds       String[]                  @default([])
  locationIds    String[]
  trackTags      String[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         InternshipStatusOption    @relation(fields: [statusId], references: [id])
  requirements   InternshipRequirementItem[]
}

model InternshipRequirementItem {
  id                String                    @id @default(cuid())
  internshipId      String
  requirementTypeId String
  isRequired        Boolean                   @default(true)
  isDone            Boolean                   @default(false)
  notes             String                    @default("")
  internship        Internship                @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  requirementType   InternshipRequirementType @relation(fields: [requirementTypeId], references: [id])
}

model CompetitionEntry {
  id                   String    @id @default(cuid())
  userId               String
  title                String
  type                 String
  scope                String
  format               String    @default("hybrid")
  startDate            DateTime?
  endDate              DateTime?
  registrationDeadline DateTime?
  location             String    @default("")
  organizer            String    @default("")
  url                  String?
  status               String
  notes                String    @default("")
  sortOrder            Int       @default(0)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SelfStudyCourse {
  id          String    @id @default(cuid())
  userId      String
  title       String
  provider    String
  status      String
  url         String?
  notes       String    @default("")
  completedAt DateTime?
  sortOrder   Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EducationBook {
  id        String  @id @default(cuid())
  userId    String
  title     String
  author    String?
  status    String
  url       String?
  notes     String  @default("")
  sortOrder Int     @default(0)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPlatform {
  id        String  @id @default(cuid())
  userId    String
  name      String
  url       String?
  notes     String  @default("")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiResource {
  id           String   @id @default(cuid())
  userId       String
  name         String
  kind         String
  targetTools  String[]
  status       String   @default("draft")
  tags         String[]
  installPath  String   @default("")
  content      String   @default("")
  frontmatter  Json?
  configFormat String   @default("markdown")
  notes        String   @default("")
  folderPath   String   @default("Inbox")
  isStarred    Boolean  @default(false)
  usageCount   Int      @default(0)
  lastUsedAt   DateTime?
  sourcePath   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, status])
  @@index([userId, folderPath])
  @@index([userId, isStarred])
}

model BachelorKnowledge {
  id         String          @id @default(cuid())
  userId     String
  folderId   String?
  courseName String
  topic      String
  notes      String          @default("")
  sortOrder  Int             @default(0)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     BachelorFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model BachelorFolder {
  id        String              @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    BachelorFolder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  BachelorFolder[]    @relation("FolderTree")
  files     BachelorFile[]
  knowledge BachelorKnowledge[]
}

model BachelorFile {
  id           String          @id @default(cuid())
  userId       String
  folderId     String?
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  notes        String          @default("")
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       BachelorFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model GraduateProgramStatusOption {
  id               String            @id @default(cuid())
  userId           String
  label            String
  sortOrder        Int               @default(0)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  graduatePrograms GraduateProgram[]
}

model GraduateProgramLocationOption {
  id        String @id @default(cuid())
  userId    String
  label     String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GraduateProgramRequirementType {
  id           String                         @id @default(cuid())
  userId       String
  label        String
  description  String                         @default("")
  sortOrder    Int                            @default(0)
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements GraduateProgramRequirementItem[]
}

model GraduateProgram {
  id             String                         @id @default(cuid())
  userId         String
  companyName    String
  title          String
  description    String                         @default("")
  applicationUrl String                         @default("")
  notes          String                         @default("")
  deadline       DateTime?
  statusId       String
  locationIds    String[]
  trackTags      String[]
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         GraduateProgramStatusOption    @relation(fields: [statusId], references: [id])
  requirements   GraduateProgramRequirementItem[]
}

model GraduateProgramRequirementItem {
  id                String                         @id @default(cuid())
  graduateProgramId String
  requirementTypeId String
  isRequired        Boolean                        @default(true)
  isDone            Boolean                        @default(false)
  notes             String                         @default("")
  graduateProgram   GraduateProgram                @relation(fields: [graduateProgramId], references: [id], onDelete: Cascade)
  requirementType   GraduateProgramRequirementType @relation(fields: [requirementTypeId], references: [id])
}

model ThesisCompany {
  id             String   @id @default(cuid())
  userId         String
  companyName    String
  topicArea      String   @default("")
  status         String
  source         String   @default("other")
  location       String   @default("")
  contactPerson  String   @default("")
  websiteUrl     String?
  targetSemester Int?
  trackTags      String[]
  notes          String   @default("")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewKnowledgeDoc {
  id             String                  @id @default(cuid())
  userId         String
  kind           String
  title          String
  content        String                  @default("")
  sourceFilename String?
  contentHash    String
  originalFileKey String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseEntries    InterviewCaseEntry[]
  bankQuestions  InterviewBankQuestion[]
  importJobs     InterviewImportJob[]

  @@unique([userId, contentHash])
  @@index([userId, kind])
}

model InterviewBankQuestion {
  id             String                @id @default(cuid())
  userId         String
  knowledgeDocId String
  text           String
  category       String
  audience       String                @default("candidate")
  status         String                @default("active")
  discardReason  String?
  origin         String                @default("rule")
  sourceText     String?
  cleanedAt      DateTime?
  tags           String[]
  contentHash    String
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeDoc   InterviewKnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)
  prepQuestions  InterviewPrepQuestion[]

  @@unique([userId, contentHash])
  @@index([userId, category])
  @@index([knowledgeDocId])
  @@index([userId, audience, status])
  @@index([knowledgeDocId, cleanedAt])
}

model InterviewCaseEntry {
  id               String                 @id @default(cuid())
  userId           String
  knowledgeDocId   String?
  title            String
  prompt           String                 @default("")
  interviewerInfo  String                 @default("")
  solution         String                 @default("")
  sourceKind       String
  caseStyle        String?
  companyTags      String[]
  contentHash      String
  approvalStatus   String                 @default("approved")
  originalFileKey  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeDoc     InterviewKnowledgeDoc? @relation(fields: [knowledgeDocId], references: [id], onDelete: SetNull)
  sessions         InterviewSession[]

  @@unique([userId, contentHash])
  @@index([userId])
  @@index([userId, approvalStatus])
}

model InterviewPrepPlan {
  id                  String                        @id @default(cuid())
  userId              String
  companyName         String
  roleTitle           String                        @default("")
  format              String
  researchModel       String                        @default("gpt-6-astra")
  status              String
  pipelineStep        String                        @default("created")
  jobAdText           String                        @default("")
  researchNotes       String                        @default("")
  searchSnippet       String                        @default("")
  companyProfileJson  String                        @default("{}")
  companyReportJson   String                        @default("")
  clarificationRound  Int                           @default(0)
  curationFilledCount Int                           @default(0)
  failureReason       String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clarifications      InterviewPrepClarification[]
  questions           InterviewPrepQuestion[]
  sessions            InterviewSession[]

  @@index([userId, status])
}

model InterviewPrepClarification {
  id        String            @id @default(cuid())
  planId    String
  question  String
  answer    String            @default("")
  sortOrder Int               @default(0)
  round     Int               @default(1)
  plan      InterviewPrepPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model InterviewPrepQuestion {
  id              String                 @id @default(cuid())
  planId          String
  text            String
  category        String
  audience        String                 @default("candidate")
  target          String
  sortOrder       Int                    @default(0)
  source          String                 @default("generated")
  bankQuestionId  String?
  storyId         String?
  gapReason       String?
  included        Boolean                @default(true)
  notes           String                 @default("")
  plan            InterviewPrepPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  bankQuestion    InterviewBankQuestion? @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
}

model InterviewImportJob {
  id             String                @id @default(cuid())
  userId         String
  knowledgeDocId String
  kind           String                @default("cases")
  status         String                @default("queued")
  progress       Int                   @default(0)
  message        String                @default("")
  resultJson     String                @default("[]")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeDoc   InterviewKnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([knowledgeDocId])
  @@index([knowledgeDocId, kind, status])
}

model CandidateBackground {
  id                   String    @id @default(cuid())
  userId               String    @unique
  cvText               String    @default("")
  cvFileName           String    @default("")
  cvUpdatedAt          DateTime?
  transcriptText       String    @default("")
  transcriptFileName   String    @default("")
  transcriptUpdatedAt  DateTime?
  notes                String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSimulatorSettings {
  id              String   @id @default(cuid())
  userId          String
  mode            String
  companyName     String   @default("")
  tone            String   @default("profesjonell")
  language        String   @default("nb")
  essentialsSheet String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mode])
}

model InterviewSession {
  id           String              @id @default(cuid())
  userId       String
  mode         String
  title        String              @default("")
  prepPlanId   String?
  planSection  String?
  caseEntryId  String?
  feedbackJson String?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prepPlan     InterviewPrepPlan?  @relation(fields: [prepPlanId], references: [id], onDelete: SetNull)
  caseEntry    InterviewCaseEntry? @relation(fields: [caseEntryId], references: [id], onDelete: SetNull)
  messages     InterviewMessage[]

  @@index([userId, mode])
}

model InterviewMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      String
  content   String           @default("")
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model InterviewAbilityTestAttempt {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  seed       Int
  correct    Boolean
  durationMs Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InterviewVideoSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  thinkSeconds  Int      @default(30)
  answerSeconds Int      @default(90)
  promptsJson   String   @default("[]")
  ratingModel   String   @default("gpt-6-astra")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewVideoRun {
  id           String   @id @default(cuid())
  userId       String
  settingsJson String
  state        String   @default("done")
  cardIndex    Int?
  blobKey      String?
  transcript   String   @default("")
  prompt       String   @default("")
  feedbackJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
