{
  "name": "careercenter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @careercenter/api & npm run dev --workspace @careercenter/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "node scripts/run-cypress-e2e.mjs",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "test:ci": "npm run test:coverage && npm run test:e2e && npm run coverage:merge",
    "db:generate": "npm run db:generate --workspace @careercenter/api",
    "db:migrate": "npm run db:migrate --workspace @careercenter/api",
    "db:seed": "npm run db:seed --workspace @careercenter/api",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detach": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "docker:prod:down": "docker compose down",
    "secrets:install-hooks": "pre-commit install",
    "secrets:scan": "pre-commit run ggshield --all-files"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^3.0.4",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
